# Ignore massive raw genomic test files from PGP data
data/raw/*.txt
data/raw/*.vcf

# Ignore massive upstream ClinVar files
data/variant_summary.txt.gz
data/variant_summary.txt

# Ignore generated blocklist files (regenerate locally via build_blocklist.py)
data/blocklist.csv
data/blocklist.db

# Python environment & cache artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Local Virtual Environments
venv/
env/
.env
venv311/
backup/

# Data files
data/*.txt
data/*.gz
data/*.db

# Result outputs (keep CSVs, ignore large txt files)
results/*.txt
results/output*.txt
results/output_eps*.txt

# Tests
tests/__pycache__/

# macOS
.DS_Store

# Editor
.vscode/